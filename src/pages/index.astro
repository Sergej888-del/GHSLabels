---
// src/pages/index.astro
// Home page for ghslabels.com.
//
// P1-B progress:
//   Section 1 (Hero)                        — commit 3361041
//   Section 2 (Pillar grid)                 — commit (Section 2 initial)
//   Section 1↔2 transition refinement       — this commit (Spectrum Mark + reduced padding)
//   Sections 3-10                           — to be added in subsequent commits
//
// Design language: Phthalo Night, commerce-genre intensity.
// CTA model: pure affiliate referral — NO Request-a-quote / RFQ / lead routing.

import Layout from '../layouts/Layout.astro';
import HubGrid from '../components/HubGrid.astro';

const pageTitle = 'GHS Labels — Independent procurement reference for EHS professionals';
const pageDescription =
  'Compare BS5609-certified label suppliers, browse chemical-resistant materials, find vetted printers for your GHS compliance operation. Independent. Vendor-neutral.';
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- ───────────────────────────────────────────────────────────────────── -->
  <!-- Section 1 — Hero                                                       -->
  <!-- ───────────────────────────────────────────────────────────────────── -->
  <!-- Asymmetric padding: generous top (pt-24/32/40), shorter bottom (pb-16/20/24) -->
  <!-- because the next section is separated by a Spectrum Mark anchor.            -->
  <section class="relative overflow-hidden bg-zinc-950 pt-24 pb-16 sm:pt-32 sm:pb-20 lg:pt-40 lg:pb-24">
    <!-- Subtle phthalo radial gradient backdrop, top-right -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 50% at 85% 15%, rgba(56, 189, 248, 0.08) 0%, transparent 60%);"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="h-px w-6 bg-sky-400"></span>
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-400">
          B2B Procurement · Independent reference
        </span>
      </div>

      <!-- H1 -->
      <h1
        class="mt-8 max-w-5xl text-5xl font-extrabold leading-[1.05] tracking-[-0.03em] text-zinc-50
               sm:text-6xl lg:text-7xl xl:text-8xl"
      >
        Certified GHS labels.<br class="hidden sm:inline" />
        <span class="sm:inline"> Compared. Sourced.</span>
      </h1>

      <!-- Subhead -->
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-zinc-300 sm:text-xl">
        An independent procurement reference for EHS professionals.
        Compare BS5609-certified suppliers, browse chemical-resistant
        materials, choose vetted printers for your operation.
      </p>

      <!-- CTA buttons -->
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href="/suppliers/"
          class="group inline-flex items-center justify-center gap-2 rounded-md
                 bg-orange-500 px-6 py-3.5
                 font-mono text-xs font-semibold uppercase tracking-wider text-zinc-950
                 transition-all duration-200
                 hover:-translate-y-0.5 hover:bg-orange-400
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-300
                 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
        >
          Browse vetted suppliers
          <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          >→</span>
        </a>

        <a
          href="/methodology/"
          class="group inline-flex items-center justify-center gap-2 rounded-md
                 border border-zinc-700 bg-zinc-900 px-6 py-3.5
                 font-mono text-xs font-semibold uppercase tracking-wider text-zinc-100
                 transition-all duration-200
                 hover:-translate-y-0.5 hover:border-zinc-600 hover:bg-zinc-800
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500
                 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
        >
          How we vet vendors
          <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          >→</span>
        </a>
      </div>

      <!-- Trust signals row -->
      <div class="mt-16 border-t border-zinc-800 pt-8 sm:mt-20">
        <ul
          class="flex flex-wrap items-center gap-x-8 gap-y-3
                 font-mono text-xs uppercase tracking-wider text-zinc-500"
        >
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-sky-400"></span>
            Independent
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-sky-400"></span>
            Vendor-neutral methodology
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-sky-400"></span>
            BS5609 expertise
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-sky-400"></span>
            EU · UK · US coverage
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────────────────────────────────────────────── -->
  <!-- Spectrum Mark — separator between Hero (zinc-950) and Section 2 (zinc-900) -->
  <!-- ───────────────────────────────────────────────────────────────────── -->
  <div class="spectrum-mark"></div>

  <!-- ───────────────────────────────────────────────────────────────────── -->
  <!-- Section 2 — Pillar grid · bento                                        -->
  <!-- ───────────────────────────────────────────────────────────────────── -->
  <!-- Reduced top padding (pt-16/20) because Spectrum Mark already creates a   -->
  <!-- visual anchor — no need for additional vertical separation from Hero.  -->
  <section class="bg-zinc-900 pt-16 pb-24 sm:pt-20 sm:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section header -->
      <div class="max-w-3xl">
        <!-- Numbered eyebrow: "01 — Browse by pillar" -->
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-400">
            01
          </span>
          <span aria-hidden="true" class="h-px w-6 bg-sky-400"></span>
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-sky-400">
            Browse by pillar
          </span>
        </div>

        <!-- H2 -->
        <h2
          class="mt-6 text-3xl font-bold tracking-[-0.02em] text-zinc-50
                 sm:text-4xl lg:text-5xl"
        >
          Find suppliers, materials, and certifications without sales pitches.
        </h2>

        <!-- Lead paragraph -->
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
          Each pillar of GHS labelling — from BS5609 suppliers to chemical-resistant
          materials and compliance methodologies — has its own dedicated section.
          Browse freely; no email gates, no sales pitches, no quote brokers.
        </p>
      </div>

      <!-- Bento grid: Suppliers featured + 6 compact tiles -->
      <div class="mt-12 sm:mt-16">
        <HubGrid featuredSlug="suppliers" />
      </div>
    </div>
  </section>

  <!-- Sections 3-10 to be added in subsequent commits -->
</Layout>
