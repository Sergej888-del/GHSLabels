---
// src/pages/suppliers/[slug].astro
//
// Supplier profile detail page.
//
// === v5 (Phase D, 27 May 2026) ===
// Token-driven full visual refactor matching Phthalo Night v3 spec.
//
// Structure:
//   1. Hero — full-width zinc-950 + .hero-radial-bg (smooth multi-stop)
//      └─ Breadcrumbs + optional AffiliateDisclosure + name/tagline/chips
//   2. Quick facts — phthalo-tinted panel with mandatory shadow stack
//   3. MDX body — softer prose typography
//   4. Strengths (phthalo cool) / Limitations (brass warm) — paired contrast
//   5. Best for — bulleted list with sky arrows
//   6. Primary CTA — orange button + brass radial glow backdrop
//   7. Related suppliers — phthalo-tinted cards
//   8. Related comparisons — phthalo-tinted cards
//   9. Inline AffiliateDisclosure (only if affiliateProgram === 'active')
//
// The cool/warm pairing of Strengths vs Limitations is editorial:
// positives lean cool brand identity, cautionary leans warm-but-not-red.
// Red is reserved exclusively for substance hazards.
//
// === Astro 6 Content Layer API ===
// - entry.id (filename-stem) for routing params, NOT entry.slug
// - render() imported from astro:content, called as render(entry)

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import Chip from '../../components/Chip.astro';
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('suppliers', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { supplier: item },
  }));
}

interface Props {
  supplier: CollectionEntry<'suppliers'>;
}

const { supplier } = Astro.props;
const { Content } = await render(supplier);

const data = supplier.data;
const hasActiveAffiliate = data.affiliateProgram === 'active';

const ctaUrl =
  hasActiveAffiliate && data.affiliateUrl ? data.affiliateUrl : data.websiteUrl;
const ctaRel = hasActiveAffiliate ? 'sponsored nofollow noopener' : 'noopener';

async function resolveRelated<C extends 'suppliers' | 'comparisons'>(
  collection: C,
  slugs: string[] | undefined
) {
  if (!slugs?.length) return [];
  const resolved = await Promise.all(
    slugs.map((slug) => getEntry(collection, slug))
  );
  return resolved.filter(
    (r): r is NonNullable<typeof r> => !!r && !r.data.draft
  );
}

const relatedSuppliers = await resolveRelated('suppliers', data.relatedSuppliers);
const relatedComparisons = await resolveRelated(
  'comparisons',
  data.relatedComparisons
);

const pricingLabel: Record<typeof data.pricingModel, string> = {
  retail: 'Retail / online catalog',
  enterprise: 'Enterprise / contract pricing',
  quote: 'Quote-based',
  mixed: 'Retail + enterprise',
};
---

<Layout
  title={data.name}
  description={data.tagline}
  pathname={`/suppliers/${supplier.id}/`}
>
  <SchemaOrg
    type="Organization"
    data={{
      name: data.name,
      url: `/suppliers/${supplier.id}/`,
      description: data.description,
      logo: data.logo,
      foundingDate: data.foundedYear ? String(data.foundedYear) : undefined,
      address: data.headquarters,
      sameAs: [data.websiteUrl],
    }}
  />

  <!-- ============== HERO — full-width zinc-950 + smooth dual radial ============== -->
  <section class="relative bg-zinc-950 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none hero-radial-bg" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-14">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Suppliers', href: '/suppliers/' },
          { label: data.name },
        ]}
      />

      {hasActiveAffiliate && <AffiliateDisclosure variant="top" />}

      <header class="pt-4">
        <div class="text-xs text-indigo-400 font-mono uppercase tracking-wider mb-3">
          Supplier profile
        </div>
        <h1 class="text-4xl sm:text-5xl font-medium text-zinc-50 tracking-tight mb-4 leading-tight">
          {data.name}
        </h1>
        <p class="text-lg text-zinc-300 leading-relaxed max-w-3xl mb-6">
          {data.tagline}
        </p>
        <div class="flex flex-wrap gap-2">
          {data.servesRegions.map((region) => (
            <Chip variant="phthalo" dot>{region}</Chip>
          ))}
          {data.ghsSpecialist && <Chip variant="brass">GHS specialist</Chip>}
          {data.foundedYear && (
            <Chip variant="neutral">Since {data.foundedYear}</Chip>
          )}
        </div>
      </header>
    </div>
  </section>

  <!-- ============== BODY — narrow container on body bg ============== -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Quick facts -->
    <section class="quick-facts">
      <div class="card-light" aria-hidden="true"></div>
      <div class="quick-facts-body">
        <h2 class="quick-facts-eyebrow">Quick facts</h2>
        <dl class="quick-facts-grid">
          {data.headquarters && (
            <div>
              <dt>Headquarters</dt>
              <dd>{data.headquarters}</dd>
            </div>
          )}
          {data.foundedYear && (
            <div>
              <dt>Founded</dt>
              <dd>{data.foundedYear}</dd>
            </div>
          )}
          <div>
            <dt>Pricing model</dt>
            <dd>{pricingLabel[data.pricingModel]}</dd>
          </div>
          <div>
            <dt>Product categories</dt>
            <dd>{data.productCategories.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- MDX body -->
    <div class="prose-supplier">
      <Content />
    </div>

    <!-- Strengths (cool) / Limitations (warm) paired -->
    <section class="paired-panels">
      <div class="panel-strengths">
        <div class="card-light" aria-hidden="true"></div>
        <div class="panel-body">
          <h2 class="panel-eyebrow panel-eyebrow-ecosystem">Strengths</h2>
          <ul class="panel-list">
            {data.strengths.map((item) => (
              <li><span class="panel-bullet-plus">+</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="panel-limitations">
        <div class="card-light" aria-hidden="true"></div>
        <div class="panel-body">
          <h2 class="panel-eyebrow panel-eyebrow-commerce">Limitations</h2>
          <ul class="panel-list">
            {data.weaknesses.map((item) => (
              <li><span class="panel-bullet-minus">−</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Best for -->
    <section class="best-for">
      <h2 class="panel-eyebrow panel-eyebrow-ecosystem">Best for</h2>
      <ul class="best-for-list">
        {data.bestFor.map((item) => (
          <li><span class="best-for-arrow">→</span><span>{item}</span></li>
        ))}
      </ul>
    </section>

    <!-- Primary CTA — orange button on brass radial glow -->
    <section class="cta-section">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-inner">
        <a href={ctaUrl} rel={ctaRel} target="_blank" class="btn-cta">
          Visit {data.name} <span aria-hidden="true">↗</span>
        </a>
        <p class="cta-note">
          {hasActiveAffiliate
            ? 'Opens supplier website · affiliate link'
            : 'Opens supplier website'}
        </p>
      </div>
    </section>

    {relatedSuppliers.length > 0 && (
      <section class="related-section">
        <h2 class="panel-eyebrow panel-eyebrow-ecosystem">Related suppliers</h2>
        <ul class="related-grid">
          {relatedSuppliers.map((rel) => (
            <li>
              <a href={`/suppliers/${rel.id}/`} class="related-card">
                <div class="card-light" aria-hidden="true"></div>
                <div class="related-card-body">
                  <div class="related-card-title">{rel.data.name}</div>
                  <div class="related-card-desc">{rel.data.tagline}</div>
                </div>
                <span class="related-card-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedComparisons.length > 0 && (
      <section class="related-section">
        <h2 class="panel-eyebrow panel-eyebrow-ecosystem">Comparisons</h2>
        <ul class="related-list">
          {relatedComparisons.map((rel) => (
            <li>
              <a href={`/compare/${rel.id}/`} class="related-card">
                <div class="card-light" aria-hidden="true"></div>
                <div class="related-card-body">
                  <div class="related-card-title">{rel.data.title}</div>
                  <div class="related-card-desc">{rel.data.verdict}</div>
                </div>
                <span class="related-card-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasActiveAffiliate && <AffiliateDisclosure variant="inline" />}
  </div>
</Layout>

<style>
  /* QUICK FACTS — phthalo-tinted panel */
  .quick-facts {
    position: relative;
    border-radius: var(--radius-card);
    padding: 22px 24px;
    margin-bottom: 36px;
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.45) 0%, var(--surface-card) 65%);
    border: 1px solid rgba(55, 48, 163, 0.55);
    box-shadow: var(--inset-top), var(--shadow-card);
    overflow: hidden;
  }
  .quick-facts > .card-light {
    position: absolute;
    inset: 0;
    background: var(--top-light-gradient);
    pointer-events: none;
    border-radius: inherit;
  }
  .quick-facts-body { position: relative; }
  .quick-facts-eyebrow {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--accent-ecosystem);
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .quick-facts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 28px;
    font: 400 13px/1.4 var(--font-sans);
    margin: 0;
  }
  .quick-facts-grid dt { color: var(--text-muted); margin-bottom: 3px; }
  .quick-facts-grid dd { color: var(--text-primary); font-weight: 500; margin: 0; }
  @media (max-width: 640px) {
    .quick-facts-grid { grid-template-columns: 1fr; gap: 12px; }
  }

  /* PROSE-SUPPLIER — MDX body */
  .prose-supplier { margin-bottom: 36px; }
  .prose-supplier :global(h2) {
    color: var(--text-primary);
    font: 500 24px/1.2 var(--font-sans);
    letter-spacing: -0.015em;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }
  .prose-supplier :global(h3) {
    color: var(--zinc-200);
    font: 500 19px/1.25 var(--font-sans);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .prose-supplier :global(p) {
    color: var(--text-secondary);
    font: 400 15px/1.75 var(--font-sans);
    margin-bottom: 1.1rem;
  }
  .prose-supplier :global(a) {
    color: var(--accent-ecosystem-glow);
    text-decoration: underline;
    text-decoration-color: var(--indigo-900);
    text-underline-offset: 3px;
    transition: color 150ms, text-decoration-color 150ms;
  }
  .prose-supplier :global(a:hover) {
    color: var(--indigo-300);
    text-decoration-color: var(--accent-ecosystem-glow);
  }
  .prose-supplier :global(ul),
  .prose-supplier :global(ol) {
    color: var(--text-secondary);
    margin-left: 1.5rem;
    margin-bottom: 1.1rem;
    font-size: 15px;
  }
  .prose-supplier :global(ul) { list-style: disc; }
  .prose-supplier :global(ol) { list-style: decimal; }
  .prose-supplier :global(li) { margin-bottom: 0.4rem; line-height: 1.75; }
  .prose-supplier :global(strong) { color: var(--text-primary); font-weight: 600; }
  .prose-supplier :global(code) {
    background: var(--surface-card);
    color: var(--amber-300);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font: 500 0.88em/1 var(--font-mono);
  }
  .prose-supplier :global(blockquote) {
    border-left: 2px solid var(--accent-ecosystem);
    padding-left: 1rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 1.75rem 0;
  }

  /* PAIRED PANELS — Strengths cool / Limitations warm */
  .paired-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 36px;
  }
  @media (max-width: 768px) {
    .paired-panels { grid-template-columns: 1fr; }
  }
  .panel-strengths,
  .panel-limitations {
    position: relative;
    border-radius: var(--radius-card);
    padding: 20px;
    overflow: hidden;
    box-shadow: var(--inset-top), var(--shadow-card);
  }
  .panel-strengths {
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.4) 0%, var(--surface-card) 65%);
    border: 1px solid rgba(55, 48, 163, 0.5);
  }
  .panel-limitations {
    background: linear-gradient(135deg, rgba(69, 26, 3, 0.4) 0%, var(--surface-card) 65%);
    border: 1px solid rgba(146, 64, 14, 0.5);
  }
  .panel-strengths > .card-light,
  .panel-limitations > .card-light {
    position: absolute;
    inset: 0;
    background: var(--top-light-gradient);
    pointer-events: none;
    border-radius: inherit;
  }
  .panel-body { position: relative; }
  .panel-eyebrow {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .panel-eyebrow-ecosystem { color: var(--accent-ecosystem); }
  .panel-eyebrow-commerce  { color: var(--amber-300); }
  .panel-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font: 400 13px/1.55 var(--font-sans);
    color: var(--zinc-200);
  }
  .panel-list li { display: flex; gap: 9px; }
  .panel-bullet-plus  { color: var(--accent-ecosystem); font-family: var(--font-mono); font-weight: 600; flex-shrink: 0; }
  .panel-bullet-minus { color: var(--amber-400); font-family: var(--font-mono); font-weight: 600; flex-shrink: 0; }

  /* BEST FOR */
  .best-for { margin-bottom: 36px; }
  .best-for-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font: 400 14px/1.55 var(--font-sans);
    color: var(--zinc-200);
  }
  .best-for-list li { display: flex; gap: 10px; }
  .best-for-arrow { color: var(--accent-ecosystem); flex-shrink: 0; font-weight: 600; }

  /* CTA — orange button on brass radial glow */
  .cta-section {
    position: relative;
    padding: 44px 0;
    margin-bottom: 36px;
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 90% at 50% 50%,
      rgba(217, 119, 6, 0.20) 0%,
      rgba(251, 191, 36, 0.06) 35%,
      transparent 75%
    );
    pointer-events: none;
    filter: blur(2px);
  }
  .cta-inner { position: relative; text-align: center; }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange-500);
    color: #ffffff;
    padding: 14px 26px;
    border-radius: var(--radius-card);
    font: 600 14px/1 var(--font-sans);
    border: 1px solid var(--orange-500);
    text-decoration: none;
    box-shadow:
      var(--inset-top-strong),
      0 6px 18px -4px rgba(249, 115, 22, 0.55),
      0 0 0 6px rgba(251, 191, 36, 0.08);
    transition: transform 500ms ease-out, background 500ms ease-out, box-shadow 500ms ease-out;
  }
  .btn-cta:hover {
    background: var(--orange-600);
    transform: translateY(-1px);
    box-shadow:
      var(--inset-top-strong),
      0 10px 28px -4px rgba(249, 115, 22, 0.65),
      0 0 0 10px rgba(251, 191, 36, 0.12);
  }
  .cta-note { margin: 14px 0 0; font: 400 11px/1.4 var(--font-sans); color: var(--text-muted); }

  /* RELATED — supplier and comparison cards */
  .related-section { margin-bottom: 36px; }
  .related-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; }
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .related-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.30) 0%, var(--surface-card) 65%);
    border: 1px solid rgba(55, 48, 163, 0.40);
    border-radius: var(--radius-card);
    box-shadow: var(--inset-top), var(--shadow-card);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 400ms ease-out, border-color 400ms ease-out, box-shadow 400ms ease-out;
  }
  .related-card > .card-light {
    position: absolute;
    inset: 0;
    background: var(--top-light-gradient);
    pointer-events: none;
    border-radius: inherit;
  }
  .related-card-body { position: relative; min-width: 0; flex-grow: 1; }
  .related-card-title {
    font: 600 14px/1.2 var(--font-sans);
    color: var(--text-primary);
    margin-bottom: 3px;
    letter-spacing: -0.01em;
  }
  .related-card-desc {
    font: 400 11px/1.4 var(--font-sans);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-arrow {
    position: relative;
    color: var(--accent-ecosystem);
    font-size: 13px;
    flex-shrink: 0;
    transition: transform 400ms ease-out, color 400ms ease-out;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.6);
    box-shadow: var(--inset-top), var(--shadow-card-strong);
  }
  .related-card:hover .related-card-arrow {
    transform: translateX(3px);
    color: var(--accent-ecosystem-glow);
  }
</style>
