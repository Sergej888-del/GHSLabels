---
// src/pages/suppliers/[slug].astro
//
// Supplier profile detail page.
//
// === v4 visual hierarchy (26 May 2026) ===
// Real warmth, not just lighter black. Each section uses semantic color tint:
//
//   - Hero: double radial gradient (phthalo top-right + amber bottom-left)
//     for cool/warm balance under the headline.
//   - Quick facts: phthalo-tinted panel (info = brand color).
//   - Strengths: phthalo-tinted panel (positive = cool brand).
//   - Limitations: amber/brass-tinted panel (caution = warm, not red).
//   - CTA: orange radial glow behind the button (commerce focal moment).
//   - Related cards: phthalo hover glow.
//
// The cool/warm pairing of Strengths (phthalo) vs Limitations (brass) is
// editorial: positive things lean toward the cool brand identity, cautionary
// things lean toward the warm-but-not-red attention tone. Red is reserved
// for actual hazards.
//
// === Astro 6 Content Layer API notes ===
// - entry.id (filename-stem) is used for routing params, not entry.slug.
// - render() is imported from astro:content and called as render(entry);
//   the legacy entry.render() method is removed in Astro 6.

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import Chip from '../../components/Chip.astro';
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('suppliers', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { supplier: item },
  }));
}

interface Props {
  supplier: CollectionEntry<'suppliers'>;
}

const { supplier } = Astro.props;
const { Content } = await render(supplier);

const data = supplier.data;
const hasActiveAffiliate = data.affiliateProgram === 'active';

const ctaUrl =
  hasActiveAffiliate && data.affiliateUrl ? data.affiliateUrl : data.websiteUrl;
const ctaRel = hasActiveAffiliate
  ? 'sponsored nofollow noopener'
  : 'noopener';

async function resolveRelated<C extends 'suppliers' | 'comparisons'>(
  collection: C,
  slugs: string[] | undefined
) {
  if (!slugs?.length) return [];
  const resolved = await Promise.all(
    slugs.map((slug) => getEntry(collection, slug))
  );
  return resolved.filter(
    (r): r is NonNullable<typeof r> => !!r && !r.data.draft
  );
}

const relatedSuppliers = await resolveRelated('suppliers', data.relatedSuppliers);
const relatedComparisons = await resolveRelated(
  'comparisons',
  data.relatedComparisons
);

const pricingLabel: Record<typeof data.pricingModel, string> = {
  retail: 'Retail / online catalog',
  enterprise: 'Enterprise / contract pricing',
  quote: 'Quote-based',
  mixed: 'Retail + enterprise',
};
---

<Layout
  title={data.name}
  description={data.tagline}
  pathname={`/suppliers/${supplier.id}/`}
>
  <SchemaOrg
    type="Organization"
    data={{
      name: data.name,
      url: `/suppliers/${supplier.id}/`,
      description: data.description,
      logo: data.logo,
      foundingDate: data.foundedYear ? String(data.foundedYear) : undefined,
      address: data.headquarters,
      sameAs: [data.websiteUrl],
    }}
  />

  <!-- Hero: full-width zinc-950 + double radial gradient -->
  <section class="relative bg-zinc-950 overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 70% 60% at top right, rgba(56, 189, 248, 0.22) 0%, transparent 65%), radial-gradient(ellipse 55% 45% at bottom left, rgba(252, 211, 77, 0.10) 0%, transparent 60%);"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Suppliers', href: '/suppliers/' },
          { label: data.name },
        ]}
      />

      {hasActiveAffiliate && <AffiliateDisclosure variant="top" />}

      <header class="pt-4">
        <div class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-3">
          Supplier profile
        </div>
        <h1 class="text-4xl sm:text-5xl font-medium text-zinc-50 tracking-tight mb-4 leading-tight">
          {data.name}
        </h1>
        <p class="text-lg text-zinc-300 leading-relaxed max-w-3xl mb-6">
          {data.tagline}
        </p>
        <div class="flex flex-wrap gap-2">
          {data.servesRegions.map((region) => (
            <Chip variant="phthalo" dot>{region}</Chip>
          ))}
          {data.ghsSpecialist && <Chip variant="brass">GHS specialist</Chip>}
          {data.foundedYear && (
            <Chip variant="neutral">Since {data.foundedYear}</Chip>
          )}
        </div>
      </header>
    </div>
  </section>

  <!-- Body content: inherits body bg-zinc-900 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Quick facts: phthalo-tinted info panel -->
    <section class="bg-gradient-to-br from-sky-950/30 via-zinc-800 to-zinc-800 border border-sky-900/50 rounded-lg p-6 mb-10">
      <h2 class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-4">
        Quick facts
      </h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
        {data.headquarters && (
          <div>
            <dt class="text-zinc-400 mb-1">Headquarters</dt>
            <dd class="text-zinc-100">{data.headquarters}</dd>
          </div>
        )}
        {data.foundedYear && (
          <div>
            <dt class="text-zinc-400 mb-1">Founded</dt>
            <dd class="text-zinc-100">{data.foundedYear}</dd>
          </div>
        )}
        <div>
          <dt class="text-zinc-400 mb-1">Pricing model</dt>
          <dd class="text-zinc-100">{pricingLabel[data.pricingModel]}</dd>
        </div>
        <div>
          <dt class="text-zinc-400 mb-1">Product categories</dt>
          <dd class="text-zinc-100">{data.productCategories.join(', ')}</dd>
        </div>
      </dl>
    </section>

    <!-- MDX body -->
    <div class="prose-supplier mb-10">
      <Content />
    </div>

    <!-- Strengths (phthalo cool) / Limitations (brass warm) — paired contrast -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
      <div class="bg-gradient-to-br from-sky-950/25 via-zinc-800 to-zinc-800 border border-sky-900/50 rounded-lg p-6">
        <h2 class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-3">
          Strengths
        </h2>
        <ul class="space-y-2 text-sm text-zinc-200">
          {data.strengths.map((item) => (
            <li class="flex gap-2">
              <span class="text-sky-400 shrink-0 font-mono">+</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-gradient-to-br from-amber-950/25 via-zinc-800 to-zinc-800 border border-amber-900/50 rounded-lg p-6">
        <h2 class="text-xs text-amber-300 font-mono uppercase tracking-wider mb-3">
          Limitations
        </h2>
        <ul class="space-y-2 text-sm text-zinc-200">
          {data.weaknesses.map((item) => (
            <li class="flex gap-2">
              <span class="text-amber-400 shrink-0 font-mono">−</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Best for -->
    <section class="mb-10">
      <h2 class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-3">
        Best for
      </h2>
      <ul class="space-y-1.5 text-zinc-200 text-sm">
        {data.bestFor.map((item) => (
          <li class="flex gap-2">
            <span class="text-sky-400 shrink-0">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Primary CTA: orange radial glow backdrop -->
    <section class="relative mb-10 py-10 border-y border-zinc-700 overflow-hidden">
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 60% 80% at center, rgba(249, 115, 22, 0.14) 0%, transparent 65%);"
        aria-hidden="true"
      ></div>
      <div class="relative text-center">
        <a
          href={ctaUrl}
          rel={ctaRel}
          target="_blank"
          class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white px-8 py-3.5 rounded-lg font-medium transition-all shadow-lg shadow-orange-500/20 hover:shadow-orange-500/30"
        >
          Visit {data.name}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="text-xs text-zinc-400 mt-3">
          {hasActiveAffiliate
            ? 'Opens supplier website · affiliate link'
            : 'Opens supplier website'}
        </p>
      </div>
    </section>

    {relatedSuppliers.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-4">
          Related suppliers
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedSuppliers.map((rel) => (
            <li>
              <a
                href={`/suppliers/${rel.id}/`}
                class="flex items-center justify-between gap-3 p-4 bg-gradient-to-br from-sky-950/20 via-zinc-800 to-zinc-800 border border-sky-900/40 rounded-lg hover:border-sky-600 hover:from-sky-950/40 transition-all"
              >
                <div class="min-w-0">
                  <div class="text-zinc-100 font-medium truncate">{rel.data.name}</div>
                  <div class="text-xs text-zinc-400 mt-1 line-clamp-2">{rel.data.tagline}</div>
                </div>
                <span class="text-sky-400 text-sm shrink-0" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedComparisons.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xs text-sky-400 font-mono uppercase tracking-wider mb-4">
          Comparisons
        </h2>
        <ul class="space-y-2">
          {relatedComparisons.map((rel) => (
            <li>
              <a
                href={`/compare/${rel.id}/`}
                class="block p-4 bg-gradient-to-br from-sky-950/20 via-zinc-800 to-zinc-800 border border-sky-900/40 rounded-lg hover:border-sky-600 hover:from-sky-950/40 transition-all"
              >
                <div class="text-zinc-100 font-medium">{rel.data.title}</div>
                <div class="text-xs text-zinc-400 mt-1">{rel.data.verdict}</div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasActiveAffiliate && <AffiliateDisclosure variant="inline" />}
  </div>
</Layout>

<style>
  /* MDX body typography — Phthalo Night v3 palette.
     Headings zinc-100 (#f4f4f5), body text zinc-200 (#e4e4e7) for softer
     long-form reading. */
  .prose-supplier :global(h2) {
    color: #f4f4f5;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-supplier :global(h3) {
    color: #e4e4e7;
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-supplier :global(p) {
    color: #d4d4d8;
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-supplier :global(a) {
    color: #38bdf8;
    text-decoration: underline;
    text-decoration-color: #0c4a6e;
    text-underline-offset: 3px;
    transition: color 150ms, text-decoration-color 150ms;
  }
  .prose-supplier :global(a:hover) {
    color: #7dd3fc;
    text-decoration-color: #38bdf8;
  }
  .prose-supplier :global(ul) {
    list-style-type: disc;
    margin-left: 1.5rem;
    color: #d4d4d8;
    margin-bottom: 1rem;
  }
  .prose-supplier :global(ol) {
    list-style-type: decimal;
    margin-left: 1.5rem;
    color: #d4d4d8;
    margin-bottom: 1rem;
  }
  .prose-supplier :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-supplier :global(strong) {
    color: #f4f4f5;
    font-weight: 500;
  }
  .prose-supplier :global(code) {
    background: #27272a;
    color: #fcd34d;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .prose-supplier :global(blockquote) {
    border-left: 2px solid #0369a1;
    padding-left: 1rem;
    color: #a1a1aa;
    font-style: italic;
    margin: 1.5rem 0;
  }
</style>
