---
// Cross-domain ecosystem banner — appears at the top of every page.
// CRITICAL: Pattern must remain identical to siblings (ghssymbols.com, ghspictograms.com)
// for visual family resemblance. See ghslabels-design-system.md §9.5.

export interface Props {
  /**
   * Which site this banner is on. Determines which label is highlighted as "You are on".
   * For ghslabels.com, this should always be 'labels'.
   */
  currentSite?: 'symbols' | 'pictograms' | 'labels';
}

const { currentSite = 'labels' } = Astro.props;
---

<div class="bg-blue-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
    <span class="text-blue-200 font-mono uppercase tracking-wider text-[10px]">
      GHS Ecosystem:
    </span>

    {currentSite === 'symbols' ? (
      <span class="text-amber-300 font-medium">▶ You are on GHS Symbols</span>
    ) : (
      <a
        href="https://ghssymbols.com/"
        class="text-blue-300 hover:text-white transition-colors"
      >
        GHS Symbols → Hazard Database
      </a>
    )}

    {currentSite === 'pictograms' ? (
      <span class="text-amber-300 font-medium">▶ You are on GHS Pictograms</span>
    ) : (
      <a
        href="https://ghspictograms.com/"
        class="text-blue-300 hover:text-white transition-colors"
      >
        GHS Pictograms → Label Constructor
      </a>
    )}

    {currentSite === 'labels' ? (
      <span class="text-amber-300 font-medium">▶ You are on GHS Labels</span>
    ) : (
      <a
        href="https://ghslabels.com/"
        class="text-blue-300 hover:text-white transition-colors"
      >
        GHS Labels → Procurement Hub
      </a>
    )}
  </div>
</div>
