---
// Supplier card — THE signature component of ghslabels.com.
//
// === v2 visual hierarchy (26 May 2026) ===
// All three variants now use zinc-800 as their base (was zinc-900) — this
// gives elevation contrast against the new body bg of zinc-900. Without this,
// neutral cards would visually disappear into the background.
//
// Neutral variant gains a subtle Phthalo gradient fade at the top, giving
// even unmarked suppliers a sense of life and depth. It's quieter than
// featured (brass) or recommended (phthalo with glow) — but no longer flat.
//
// === Variant semantics ===
// Featured (brass) = top-tier with active affiliate, brass gradient + brass glow halo.
// Recommended (phthalo) = editorial pick, phthalo border + phthalo glow halo.
// Neutral = generic listing, subtle phthalo fade + zinc border, no glow.
//
// Glow halos are semantic, not decorative:
//   - Brass glow signals "premium / certified" (warm coal-glow)
//   - Phthalo glow signals "editorial recommendation" (cool brand-glow)
//   - Hover intensifies the glow to invite interaction
//
// Usage:
//   <SupplierCard
//     name="DuraLabel"
//     tagline="BS5609-certified marine-grade specialists."
//     href="/suppliers/duralabel/"
//     marker="featured"
//     tags={['EU/US', 'BS5609', 'Enterprise']}
//   />

export interface Props {
  name: string;
  tagline: string;
  href: string;
  marker?: 'featured' | 'recommended' | null;
  tags?: string[];
}

const { name, tagline, href, marker = null, tags = [] } = Astro.props;

// Card container styles per marker variant.
// All variants base on zinc-800 (elevated above body zinc-900).
const cardClasses =
  marker === 'featured'
    ? 'border border-amber-900 bg-gradient-to-b from-amber-950/70 from-0% via-zinc-800 via-40% to-zinc-800 to-100% hover:border-amber-700 glow-brass hover:glow-brass-strong'
    : marker === 'recommended'
    ? 'border border-sky-800 bg-zinc-800 hover:border-sky-600 glow-phthalo hover:glow-phthalo-strong'
    : 'border border-zinc-700 bg-gradient-to-b from-sky-950/40 from-0% via-zinc-800 via-35% to-zinc-800 to-100% hover:border-sky-800';

const markerLabel =
  marker === 'featured' ? 'Featured' : marker === 'recommended' ? 'Recommended' : null;

const markerClasses =
  marker === 'featured'
    ? 'bg-amber-950/80 text-amber-300 border-amber-900'
    : marker === 'recommended'
    ? 'bg-sky-950/80 text-sky-300 border-sky-900'
    : '';

const linkColor =
  marker === 'featured'
    ? 'text-amber-300 group-hover:text-amber-200'
    : 'text-sky-400 group-hover:text-sky-300';
---

<a
  href={href}
  class={`group block rounded-xl p-7 transition-all duration-200 ${cardClasses}`}
>
  {(markerLabel || tags.length > 0) && (
    <div class="flex flex-wrap gap-2 mb-5">
      {markerLabel && (
        <span class={`inline-block px-2.5 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-semibold border ${markerClasses}`}>
          {markerLabel}
        </span>
      )}
      {tags.map((tag) => (
        <span class="inline-block px-2.5 py-0.5 rounded bg-zinc-800/80 text-zinc-400 text-[10px] font-mono uppercase tracking-wider border border-zinc-700">
          {tag}
        </span>
      ))}
    </div>
  )}
  <h3 class="text-xl font-semibold text-zinc-50 mb-2 tracking-tight">{name}</h3>
  <p class="text-sm text-zinc-400 leading-relaxed mb-6">{tagline}</p>
  <span class={`inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider font-medium transition-colors ${linkColor}`}>
    View profile <span aria-hidden="true">&rarr;</span>
  </span>
</a>
