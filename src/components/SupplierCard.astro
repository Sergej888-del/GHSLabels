---
// Supplier card — THE signature component of ghslabels.com.
//
// === v3 visual hierarchy (26 May 2026) ===
// Cards are no longer flat. Each variant has a visible color accent at the
// top that fades into a zinc-800 base. This produces real depth on the body
// zinc-900 page surface, not just a barely-visible border.
//
// Featured (brass) gets the strongest gradient (70% opacity from top stop)
// plus its glow halo. Recommended (phthalo) gets a 50% phthalo gradient plus
// phthalo glow. Neutral (no marker) still gets a 50% phthalo gradient — not
// as strong as recommended, but clearly visible.
//
// === Variant semantics ===
// Featured (brass)     = active affiliate, top-tier — warm coal glow
// Recommended (phthalo) = editorial pick — cool brand glow
// Neutral              = generic listing — subtle phthalo accent, no glow
//
// Usage:
//   <SupplierCard
//     name="DuraLabel"
//     tagline="BS5609-certified marine-grade specialists."
//     href="/suppliers/duralabel/"
//     marker="featured"
//     tags={['EU/US', 'BS5609', 'Enterprise']}
//   />

export interface Props {
  name: string;
  tagline: string;
  href: string;
  marker?: 'featured' | 'recommended' | null;
  tags?: string[];
}

const { name, tagline, href, marker = null, tags = [] } = Astro.props;

// Card container styles per marker variant.
// All variants use zinc-800 base (elevated above body zinc-900) with visible
// color accent gradient at top.
const cardClasses =
  marker === 'featured'
    ? 'border border-amber-800 bg-gradient-to-b from-amber-950/80 from-0% via-zinc-800 via-45% to-zinc-800 to-100% hover:border-amber-600 glow-brass hover:glow-brass-strong'
    : marker === 'recommended'
    ? 'border border-sky-800 bg-gradient-to-b from-sky-950/70 from-0% via-zinc-800 via-45% to-zinc-800 to-100% hover:border-sky-500 glow-phthalo hover:glow-phthalo-strong'
    : 'border border-sky-900/60 bg-gradient-to-b from-sky-950/55 from-0% via-zinc-800 via-40% to-zinc-800 to-100% hover:border-sky-700 hover:from-sky-950/70';

const markerLabel =
  marker === 'featured' ? 'Featured' : marker === 'recommended' ? 'Recommended' : null;

const markerClasses =
  marker === 'featured'
    ? 'bg-amber-950/80 text-amber-300 border-amber-900'
    : marker === 'recommended'
    ? 'bg-sky-950/80 text-sky-300 border-sky-900'
    : '';

const linkColor =
  marker === 'featured'
    ? 'text-amber-300 group-hover:text-amber-200'
    : 'text-sky-400 group-hover:text-sky-300';
---

<a
  href={href}
  class={`group block rounded-xl p-7 transition-all duration-200 ${cardClasses}`}
>
  {(markerLabel || tags.length > 0) && (
    <div class="flex flex-wrap gap-2 mb-5">
      {markerLabel && (
        <span class={`inline-block px-2.5 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-semibold border ${markerClasses}`}>
          {markerLabel}
        </span>
      )}
      {tags.map((tag) => (
        <span class="inline-block px-2.5 py-0.5 rounded bg-zinc-900/80 text-zinc-300 text-[10px] font-mono uppercase tracking-wider border border-zinc-700">
          {tag}
        </span>
      ))}
    </div>
  )}
  <h3 class="text-xl font-semibold text-zinc-50 mb-2 tracking-tight">{name}</h3>
  <p class="text-sm text-zinc-300 leading-relaxed mb-6">{tagline}</p>
  <span class={`inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider font-medium transition-colors ${linkColor}`}>
    View profile <span aria-hidden="true">&rarr;</span>
  </span>
</a>
