---
// src/components/HeroHome.astro
//
// Home page hero — animated dot field + radial backdrop + content.
//
// === v2 (Phase E.3, 27 May 2026) ===
// Pictogram cluster removed. The inline SVG approximations were not crisp
// enough to compete with the dot field, and visually crowded the headline.
// The hero now combines:
//   1. zinc-950 base canvas
//   2. .hero-radial-bg overlay (smooth cool/warm dual radial)
//   3. Animated DotField (diagonal sweep wave + per-dot oscillation)
//   4. Inner content (eyebrow + H1 80px + subhead + dual CTA + trust strip)
//
// Vignette also removed — without pictograms competing for attention, the
// radial backdrop alone provides enough edge softening.
//
// === Props (all optional) ===
// Default copy mirrors current production. Override from /pages/index.astro
// for A/B testing.

export interface CtaProps {
  href: string;
  label: string;
}

export interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  primaryCta?: CtaProps;
  secondaryCta?: CtaProps;
}

const {
  eyebrow = 'B2B PROCUREMENT · INDEPENDENT REFERENCE',
  headline = 'Certified GHS labels. Compared. Sourced.',
  subhead = 'An independent procurement reference for EHS professionals. Compare BS5609-certified suppliers, browse chemical-resistant materials, choose vetted printers for your operation.',
  primaryCta = { href: '/suppliers/', label: 'Browse vetted suppliers' },
  secondaryCta = { href: '/methodology/', label: 'How we vet vendors' },
} = Astro.props;
---

<section class="hero-home" data-hero-home>
  <h2 class="visually-hidden">Hero — GHS labels, procurement-grade</h2>

  <!-- Cool/warm radial backdrop (matches supplier detail + hub pages for consistency) -->
  <div class="hero-radial-bg-overlay" aria-hidden="true"></div>

  <!-- Animated dot field canvas -->
  <canvas class="hero-dot-field" aria-hidden="true"></canvas>

  <!-- Inner content -->
  <div class="hero-inner">
    <div class="hero-eyebrow">— {eyebrow}</div>
    <h1 class="hero-headline">{headline}</h1>
    <p class="hero-subhead">{subhead}</p>
    <div class="hero-ctas">
      <a href={primaryCta.href} class="btn-cta-primary">
        {primaryCta.label} <span aria-hidden="true">→</span>
      </a>
      <a href={secondaryCta.href} class="btn-cta-ghost">
        {secondaryCta.label} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="hero-trust">
      <span class="trust-dot" aria-hidden="true">·</span>
      <span>INDEPENDENT</span>
      <span class="trust-sep" aria-hidden="true">·</span>
      <span>VENDOR-NEUTRAL METHODOLOGY</span>
      <span class="trust-sep" aria-hidden="true">·</span>
      <span>BS5609 EXPERTISE</span>
      <span class="trust-sep" aria-hidden="true">·</span>
      <span>EU · UK · US COVERAGE</span>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     HERO CONTAINER
     ============================================================ */
  .hero-home {
    position: relative;
    min-height: calc(100vh - 88px);
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--surface-page);
  }

  @media (max-width: 1024px) {
    .hero-home { min-height: auto; padding: 60px 0 80px; }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ============================================================
     RADIAL BACKDROP — uses the same hero-radial-bg utility from global.css
     but as an absolute overlay (since hero-home itself has the canvas).
     ============================================================ */
  .hero-radial-bg-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      ellipse 65% 55% at 100% 0%,
      rgba(67, 56, 202, 0.14) 0%,
      rgba(67, 56, 202, 0.08) 25%,
      rgba(67, 56, 202, 0.03) 50%,
      transparent 75%
    );
  }

  /* ============================================================
     DOT FIELD CANVAS — sits above the radial backdrop
     ============================================================ */
  .hero-dot-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* ============================================================
     INNER CONTENT
     ============================================================ */
  .hero-inner {
    position: relative;
    z-index: 2;
    padding: 80px 80px 96px;
    max-width: 880px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .hero-inner { padding: 48px 32px 40px; max-width: 100%; }
  }

  @media (max-width: 640px) {
    .hero-inner { padding: 36px 20px 32px; }
  }

  .hero-eyebrow {
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--accent-ecosystem);
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .hero-headline {
    font: 700 80px/1.0 var(--font-sans);
    letter-spacing: -0.035em;
    color: var(--text-strong);
    margin: 0 0 22px;
  }

  @media (max-width: 1200px) { .hero-headline { font-size: 64px; } }
  @media (max-width: 768px)  { .hero-headline { font-size: 44px; line-height: 1.05; } }
  @media (max-width: 480px)  { .hero-headline { font-size: 36px; } }

  .hero-subhead {
    font: 400 17px/1.55 var(--font-sans);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 36px;
  }

  @media (max-width: 640px) { .hero-subhead { font-size: 15px; margin-bottom: 28px; } }

  /* ============================================================
     CTA BUTTONS
     ============================================================ */
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 56px;
  }

  .btn-cta-primary,
  .btn-cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: var(--radius-card);
    font: 600 14px/1 var(--font-sans);
    letter-spacing: -0.005em;
    text-decoration: none;
    transition:
      transform 500ms ease-out,
      background 500ms ease-out,
      border-color 500ms ease-out,
      box-shadow 500ms ease-out,
      color 500ms ease-out;
  }

  .btn-cta-primary {
    background: var(--orange-500);
    color: #ffffff;
    border: 1px solid var(--orange-500);
    box-shadow:
      var(--inset-top-strong),
      0 6px 18px -4px rgba(249, 115, 22, 0.55),
      0 0 0 6px rgba(251, 191, 36, 0.10);
    animation: amber-pulse 3s ease-in-out infinite;
  }

  .btn-cta-primary:hover {
    background: var(--orange-600);
    transform: translateY(-1px);
    box-shadow:
      var(--inset-top-strong),
      0 10px 28px -4px rgba(249, 115, 22, 0.65),
      0 0 0 10px rgba(251, 191, 36, 0.14);
  }

  .btn-cta-ghost {
    background: transparent;
    color: var(--zinc-200);
    border: 1px solid var(--border-default);
  }

  .btn-cta-ghost:hover {
    border-color: var(--zinc-500);
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  /* ============================================================
     TRUST STRIP
     ============================================================ */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .trust-dot {
    color: var(--accent-ecosystem);
    font-weight: 700;
  }

  .trust-sep {
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .hero-trust { font-size: 9px; gap: 6px 8px; }
  }
</style>

<script>
  import { initDotField } from '../scripts/dotField';

  function init() {
    const canvas = document.querySelector('.hero-dot-field');
    if (canvas instanceof HTMLCanvasElement) {
      initDotField(canvas, 1);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
