---
// src/components/HubCard.astro
//
// One hub card. Variants depend on `intent` field of the Hub (set in src/lib/hubs.ts).
//
// === Design v3 (permanent visual character, like SupplierCard) ===
//
// Populated states (count > 0 or undefined):
//   phthalo (directory/comparison/reference):
//     • permanent sky-400 glow halo (2-layer box-shadow)
//     • inner radial gradient top-right (sky-400 @ 10% → transparent)
//     • border sky-400 @ 20% → @ 40% on hover
//     • halo intensifies on hover
//
//   brass (commerce):
//     • permanent amber-500 glow halo (2-layer box-shadow)
//     • inner radial gradient top-right (amber-500 @ 10% → transparent)
//     • border amber-500 @ 20% → @ 40% on hover
//     • halo intensifies on hover
//
//   neutral (editorial):
//     • no glow, no gradient
//     • plain zinc-800 border → zinc-700 on hover
//     • creates intentional visual hierarchy: 4 phthalo + 2 brass + 1 neutral
//
// Coming-soon state (count === 0):
//   • dimmed (opacity 60%), not clickable, no link
//   • glow + gradient overridden via !important
//   • "Coming soon" badge instead of count
//
// Self-contained: does not depend on .glow-* utilities from global.css.

import type { Hub } from '../lib/hubs';
import { getHubUrl } from '../lib/hubs';

interface Props {
  hub: Hub;
  count?: number;
}

const { hub, count } = Astro.props;
const url = getHubUrl(hub);
const isPopulated = count === undefined || count > 0;
const showComingSoon = count === 0;

// intent → abbr-square palette
const abbrPalette: Record<Hub['intent'], string> = {
  directory:  'bg-sky-950 text-sky-400',
  comparison: 'bg-sky-950 text-sky-400',
  reference:  'bg-sky-950 text-sky-400',
  commerce:   'bg-amber-950 text-amber-300',
  editorial:  'bg-zinc-800 text-zinc-300',
};

// intent → "Explore →" link color (matches abbr-square family for internal consistency)
const explorePalette: Record<Hub['intent'], string> = {
  directory:  'text-sky-400 group-hover:text-sky-300',
  comparison: 'text-sky-400 group-hover:text-sky-300',
  reference:  'text-sky-400 group-hover:text-sky-300',
  commerce:   'text-amber-300 group-hover:text-amber-200',
  editorial:  'text-zinc-400 group-hover:text-zinc-300',
};

const Tag = isPopulated ? 'a' : 'div';
const linkProps = isPopulated ? { href: url } : {};
---

<Tag
  {...linkProps}
  data-intent={hub.intent}
  class:list={[
    'hub-card group block rounded-lg p-6',
    'transition-all duration-200',
    isPopulated && 'hub-card-populated hover:-translate-y-0.5',
    !isPopulated && 'hub-card-coming-soon cursor-default opacity-60',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <!-- Mono 3-letter abbr square -->
    <div
      class:list={[
        'flex h-10 w-10 items-center justify-center rounded-md',
        'font-mono text-sm font-medium tracking-tight',
        abbrPalette[hub.intent],
      ]}
    >
      {hub.abbr}
    </div>

    <!-- Count caption OR Coming soon badge -->
    {count !== undefined && count > 0 && (
      <span class="font-mono text-xs uppercase tracking-wider text-zinc-500">
        {count} {hub.countLabel}
      </span>
    )}
    {showComingSoon && (
      <span class="font-mono text-xs uppercase tracking-wider text-zinc-600">
        Coming soon
      </span>
    )}
  </div>

  <h3 class="mt-4 text-xl font-semibold tracking-tight text-zinc-50">
    {hub.label}
  </h3>

  <p class="mt-2 text-sm leading-relaxed text-zinc-400">
    {hub.description}
  </p>

  {isPopulated && (
    <span
      class:list={[
        'mt-4 inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider',
        'transition-colors duration-150',
        explorePalette[hub.intent],
      ]}
    >
      Explore <span aria-hidden="true">→</span>
    </span>
  )}
</Tag>

<style>
  /* === Base card === */
  .hub-card {
    position: relative;
    background-color: #18181b; /* zinc-900 */
    border: 1px solid #27272a; /* zinc-800 */
  }

  /* === Phthalo (sky) — directory / comparison / reference === */
  .hub-card-populated[data-intent='directory'],
  .hub-card-populated[data-intent='comparison'],
  .hub-card-populated[data-intent='reference'] {
    background-color: #18181b;
    background-image: radial-gradient(
      ellipse 80% 60% at top right,
      rgba(56, 189, 248, 0.10) 0%,
      transparent 60%
    );
    border-color: rgba(56, 189, 248, 0.20);
    box-shadow:
      0 0 18px -3px rgba(56, 189, 248, 0.22),
      0 0 44px -12px rgba(56, 189, 248, 0.14);
  }

  .hub-card-populated[data-intent='directory']:hover,
  .hub-card-populated[data-intent='comparison']:hover,
  .hub-card-populated[data-intent='reference']:hover {
    border-color: rgba(56, 189, 248, 0.42);
    box-shadow:
      0 0 28px -3px rgba(56, 189, 248, 0.40),
      0 0 64px -12px rgba(56, 189, 248, 0.24);
  }

  /* === Brass (amber) — commerce === */
  .hub-card-populated[data-intent='commerce'] {
    background-color: #18181b;
    background-image: radial-gradient(
      ellipse 80% 60% at top right,
      rgba(245, 158, 11, 0.10) 0%,
      transparent 60%
    );
    border-color: rgba(245, 158, 11, 0.20);
    box-shadow:
      0 0 18px -3px rgba(245, 158, 11, 0.22),
      0 0 44px -12px rgba(245, 158, 11, 0.14);
  }

  .hub-card-populated[data-intent='commerce']:hover {
    border-color: rgba(245, 158, 11, 0.42);
    box-shadow:
      0 0 28px -3px rgba(245, 158, 11, 0.40),
      0 0 64px -12px rgba(245, 158, 11, 0.24);
  }

  /* === Neutral (zinc) — editorial === */
  /* No glow, no gradient — intentional hierarchy: 4 phthalo + 2 brass + 1 neutral */
  .hub-card-populated[data-intent='editorial']:hover {
    border-color: #3f3f46; /* zinc-700 */
  }

  /* === Coming-soon override — kills all intent-specific styling === */
  .hub-card-coming-soon {
    background-image: none !important;
    box-shadow: none !important;
    border-color: rgba(39, 39, 42, 0.60) !important; /* zinc-800/60 */
  }
</style>
