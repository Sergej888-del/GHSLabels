---
// Base layout for ghslabels.com - Phthalo Night v3 (Phase B.2).
//
// === v3 changes (Phase B.2, 27 May 2026) ===
// - Add <StickyHeader /> between top Spectrum Mark and <main>
// - EcosystemBanner now renders sky gradient (component update separate file)
// - Body bg stays bg-zinc-900 in this phase (defer to Phase D when supplier
//   detail components refactor to consume tokens directly)
//
// === Preserved from Phase A (64b31ea) ===
// - Geist + Geist Mono font imports
// - All SEO meta, OG, JSON-LD
// - Footer 4-column grid with ecosystem links
// - Spectrum Mark above + below main content

import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import EcosystemBanner from '../components/EcosystemBanner.astro';
import StickyHeader from '../components/StickyHeader.astro';

export interface Props {
  title: string;
  description: string;
  /** Canonical path. Defaults to current path. */
  pathname?: string;
  /** Open Graph image. Defaults to /og-default.png. */
  ogImage?: string;
  /** Schema.org type override. Defaults to 'WebPage'. */
  schemaType?: string;
  /** Set true to noindex the page. */
  noindex?: boolean;
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
  ogImage = '/og-default.png',
  schemaType = 'WebPage',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://ghslabels.com';
const canonical = `${siteUrl}${pathname}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = title.includes('GHS Labels') ? title : `${title} | GHS Labels`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      Значки (session 37). ⚠⚠ public/favicon.ico был дефолтным значком Astro —
      чёрный квадрат с ракетой; md5 совпадал во всех трёх репозиториях экосистемы.
      ⚠ .ico несёт три кадра (16, 32, 48), кадр 16 нарисован по пиксельной сетке,
      а не сжат из 32: при сжатии полосы знака замыливаются.
      ⚠ apple-touch-icon непрозрачный: iOS подставляет под прозрачность чёрный.
      ⚠ Акцент знака здесь brass-300 #fcd34d — им ghslabels отличается от
      ghspictograms (teal-300) и ghssymbols (sky-300).
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Mobile browser chrome - matches dark theme -->
    {/* ⚠ Здесь #18181b, а не navy: у ghslabels своя тёмная тема. theme_color
        в site.webmanifest выставлен таким же — они обязаны совпадать. */}
    <meta name="theme-color" content="#18181b" />

    <!-- Open Graph -->
    {/* ⚠⚠ og-default.png на этом домене не было ВОВСЕ: og:image указывал на
        несуществующий файл, и превью в соцсетях выходило пустым. */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GHS Labels" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- JSON-LD: base WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'GHS Labels',
      'url': siteUrl,
      'description': 'Independent reference for GHS chemical labels: requirements, suppliers, and materials. OSHA HCS and EU CLP.',
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-900 text-zinc-100">
    <EcosystemBanner currentSite="labels" />
    <div class="spectrum-mark"></div>
    <StickyHeader />
    <main class="flex-1">
      <slot />
    </main>
    <div class="spectrum-mark"></div>
    <footer class="bg-zinc-950 text-zinc-400 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-1">
            <p class="text-zinc-50 font-bold text-lg mb-3 tracking-tight">
              GHS Labels<span class="text-indigo-400">.</span>
            </p>
            <p class="text-sm leading-relaxed text-zinc-400 max-w-xs">
              Independent reference for GHS chemical labels. Understand the requirements, then source suppliers and materials.
            </p>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Procurement</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/suppliers/" class="hover:text-zinc-50 transition-colors">Suppliers</a></li>
              <li><a href="/materials/" class="hover:text-zinc-50 transition-colors">Materials</a></li>
              <li><a href="/industries/" class="hover:text-zinc-50 transition-colors">Industries</a></li>
            </ul>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Resources</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/methodology/" class="hover:text-zinc-50 transition-colors">Methodology</a></li>
              <li><a href="/guides/" class="hover:text-zinc-50 transition-colors">Guides</a></li>
              <li><a href="/about/" class="hover:text-zinc-50 transition-colors">About</a></li>
              <li><a href="/contact/" class="hover:text-zinc-50 transition-colors">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Legal</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/affiliate-disclosure/" class="hover:text-zinc-50 transition-colors">Affiliate disclosure</a></li>
              <li><a href="/privacy/" class="hover:text-zinc-50 transition-colors">Privacy</a></li>
              <li><a href="/terms/" class="hover:text-zinc-50 transition-colors">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-zinc-800 pt-8 flex flex-col sm:flex-row justify-between gap-4 text-xs text-zinc-500 font-mono">
          <p>&copy; 2026 GHS Labels &middot; Part of the GHS Ecosystem</p>
          <div class="flex gap-5">
            <a href="https://ghssymbols.com/" class="hover:text-indigo-300 transition-colors">GHS Symbols</a>
            <a href="https://ghspictograms.com/" class="hover:text-indigo-300 transition-colors">GHS Pictograms</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
