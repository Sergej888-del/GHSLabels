---
// Base layout for ghslabels.com - Phthalo Night v3 (Phase A).
//
// === v3 changes (27 May 2026) ===
// - Font swap: Inter → Geist (via @fontsource-variable/geist + geist-mono)
// - Imports updated; body bg/text utility classes unchanged from v2
//   (Phase B will introduce StickyHeader + body bg adjustments)
// - No visual structure changes in this phase beyond typeface
//
// === Preserved from v2 (fea669a) ===
// - Body bg-zinc-900 + footer zinc-950 hierarchy
// - SEO meta, EcosystemBanner, Spectrum Mark placement
// - Footer 4-column grid with ecosystem links
//
// All per-page SEO meta requirements: ghslabels-architecture.md §5.

import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import EcosystemBanner from '../components/EcosystemBanner.astro';

export interface Props {
  title: string;
  description: string;
  /** Canonical path. Defaults to current path. */
  pathname?: string;
  /** Open Graph image. Defaults to /og-default.png. */
  ogImage?: string;
  /** Schema.org type override. Defaults to 'WebPage'. */
  schemaType?: string;
  /** Set true to noindex the page. */
  noindex?: boolean;
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
  ogImage = '/og-default.png',
  schemaType = 'WebPage',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://ghslabels.com';
const canonical = `${siteUrl}${pathname}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = title.includes('GHS Labels') ? title : `${title} | GHS Labels`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Mobile browser chrome - matches dark theme -->
    <meta name="theme-color" content="#18181b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="GHS Labels" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- JSON-LD: base WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'GHS Labels',
      'url': siteUrl,
      'description': 'Independent procurement reference for GHS chemical labels - compare suppliers, materials, and printing services.',
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-900 text-zinc-100">
    <EcosystemBanner currentSite="labels" />
    <div class="spectrum-mark"></div>
    <main class="flex-1">
      <slot />
    </main>
    <div class="spectrum-mark"></div>
    <footer class="bg-zinc-950 text-zinc-400 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-1">
            <p class="text-zinc-50 font-bold text-lg mb-3 tracking-tight">
              GHS Labels<span class="text-sky-400">.</span>
            </p>
            <p class="text-sm leading-relaxed text-zinc-400 max-w-xs">
              Independent procurement reference for GHS chemical labels. Compare suppliers, materials, and certified printing services.
            </p>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Procurement</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/suppliers/" class="hover:text-zinc-50 transition-colors">Suppliers</a></li>
              <li><a href="/compare/" class="hover:text-zinc-50 transition-colors">Compare</a></li>
              <li><a href="/materials/" class="hover:text-zinc-50 transition-colors">Materials</a></li>
              <li><a href="/industries/" class="hover:text-zinc-50 transition-colors">Industries</a></li>
            </ul>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Resources</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/methodology/" class="hover:text-zinc-50 transition-colors">Methodology</a></li>
              <li><a href="/guides/" class="hover:text-zinc-50 transition-colors">Buyer&apos;s guides</a></li>
              <li><a href="/about/" class="hover:text-zinc-50 transition-colors">About</a></li>
              <li><a href="/contact/" class="hover:text-zinc-50 transition-colors">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="text-zinc-50 font-mono text-xs mb-4 uppercase tracking-wider font-semibold">Legal</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/affiliate-disclosure/" class="hover:text-zinc-50 transition-colors">Affiliate disclosure</a></li>
              <li><a href="/privacy/" class="hover:text-zinc-50 transition-colors">Privacy</a></li>
              <li><a href="/terms/" class="hover:text-zinc-50 transition-colors">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-zinc-800 pt-8 flex flex-col sm:flex-row justify-between gap-4 text-xs text-zinc-500 font-mono">
          <p>&copy; 2026 GHS Labels &middot; Part of the GHS Ecosystem</p>
          <div class="flex gap-5">
            <a href="https://ghssymbols.com/" class="hover:text-sky-300 transition-colors">GHS Symbols</a>
            <a href="https://ghspictograms.com/" class="hover:text-sky-300 transition-colors">GHS Pictograms</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
